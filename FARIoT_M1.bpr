        <org.eventb.core.prPred name="p7" org.eventb.core.predicate="¬heater=door_lock"/>
        <org.eventb.core.prPred name="p55" org.eventb.core.predicate="∃x⦂VALUE·ac ↦ x∈{act_dev(r)} ⩤ state∨ac ↦ x∈{act_dev(r) ↦ act_val(r)}"/>
        <org.eventb.core.prPred name="p73" org.eventb.core.predicate="act_val∈RULE → VALUE"/>
