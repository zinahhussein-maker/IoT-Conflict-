        <org.eventb.core.prPred name="p35" org.eventb.core.predicate="∀r⦂RULE·⊤⇒(act_dev(r)=door_lock⇔act_val(r)∈{LOCKED,UNLOCKED})">
            <org.eventb.core.prIdent name="LOCKED" org.eventb.core.type="VALUE"/>
