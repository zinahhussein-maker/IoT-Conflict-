        <org.eventb.core.prPred name="p113" org.eventb.core.predicate="(∃x⦂VALUE·humidifier∉{act_dev(r)}∧humidifier ↦ x∈state)∨(∃x⦂VALUE·humidifier=act_dev(r)∧x=act_val(r))"/>
        <org.eventb.core.prPred name="p49" org.eventb.core.predicate="ac∈dom(state{act_dev(r) ↦ act_val(r)})"/>
