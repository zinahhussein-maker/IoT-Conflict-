<org.eventb.core.axiom name="_8" org.eventb.core.label="axm1" org.eventb.core.predicate="score ∈ THETA → (RULE → ℤ)" org.eventb.core.theorem="false"/>
<org.eventb.core.axiom name="_9" org.eventb.core.label="axm2" org.eventb.core.predicate="pref ∈ THETA × RULE × RULE → RULE" org.eventb.core.theorem="false"/>
<org.eventb.core.axiom name="_10" org.eventb.core.label="axm3" org.eventb.core.predicate="∀t,r1,r2· t ∈ THETA ∧ r1 ∈ RULE ∧ r2 ∈ RULE ⇒ (score(t)(r1) ≥ score(t)(r2) ⇒ pref(t ↦ r1 ↦ r2) = r1) ∧ (score(t)(r1) &lt; score(t)(r2) ⇒ pref(t ↦ r1 ↦ r2) = r2)" org.eventb.core.theorem="false"/>
<org.eventb.core.axiom name="_11" org.eventb.core.label="axm4" org.eventb.core.predicate="Critical = {door_lock}" org.eventb.core.theorem="false"/>
<org.eventb.core.axiom name="_12" org.eventb.core.label="axm5" org.eventb.core.predicate="Theta_safe = {t ∣ t ∈ THETA ∧ (∀a,b· a ∈ RULE ∧ b ∈ RULE ∧ act_dev(a) ∈ Critical ∧ act_dev(b) = act_dev(a) ∧ act_val(a) = LOCKED ∧ act_val(b) = UNLOCKED ⇒ score(t)(a) &gt; score(t)(b))}" org.eventb.core.theorem="false"/>
