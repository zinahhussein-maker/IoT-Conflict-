    <org.eventb.core.event name="_60" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="SetHumidity">
        <org.eventb.core.refinesEvent name="_61" org.eventb.core.target="SetHumidity"/>
    </org.eventb.core.event>
</org.eventb.core.machineFile>
